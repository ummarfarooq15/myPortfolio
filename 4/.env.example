PORT=5000
NODE_ENV=development
ADMIN_USER=admin
# Generate with: ADMIN_PASSWORD='your password' node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.env.ADMIN_PASSWORD,s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-salt-colon-scrypt-hash
# Use at least 32 random characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# Optional absolute path to persistent storage. Defaults to ./private-data/messages.json
# DATA_DIR=/var/lib/ummar-portfolio
